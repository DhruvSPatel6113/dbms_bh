# ==============================================================================
# Library Management System: Root Environment Variable Template
# ==============================================================================

# Server Network Configuration
PORT=4000
NODE_ENV=development

# Primary PostgreSQL 16 Database Connection URL (for dev and migrations)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/library_dev?schema=public"

# Isolated PostgreSQL 16 Test Database Connection URL (for Jest / Supertest)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/library_test?schema=public"

# JSON Web Token Secret & Expiry
JWT_SECRET="development-jwt-secret-key-at-least-32-chars-long"
JWT_EXPIRES_IN="8h"

# Optional External API Keys
GOOGLE_BOOKS_API_KEY=""

# Quality Gate Settings
GATE_MAX_ATTEMPTS=3
GATE_MIN_TESTS=150
GATE_MAX_FLAKY=0

# Frontend Base URL
VITE_API_BASE_URL="/api"

